{
  "name": "sfqa-scar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Executable scar tissue: a test suite's past failures turned into rules a reviewer runs on every commit.",
  "license": "MIT",
  "author": "Vaishali Desarda",
  "homepage": "https://www.vaishalidesarda.com",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "npm run typecheck --prefix packages/scar",
    "test": "npm run test --prefix packages/scar",
    "build": "npm run build --prefix packages/scar",
    "verify": "node packages/scar/scripts/verify.mjs",
    "validate:scar": "node packages/scar/dist/cli.js prove --fixtures scar-validation/fixtures",
    "check": "npm run typecheck && npm test && npm run build && npm run verify && npm run validate:scar",
    "new:rule": "node packages/scar/dist/cli.js new"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.20.3",
    "typescript": "^6.0.3"
  }
}
